# Copy to terraform.tfvars (git-ignored) and fill in the placeholders.
deploy_ssh_public_key = "ssh-ed25519 AAAA... truckroute-deploy"
cloudflare_zone_id    = "<zone id from the Cloudflare dashboard>"
app_domain            = "truckroute.example.com"

# Optional overrides (defaults shown):
