# availability_zone          = "us-east-1a"
# bundle_id                  = "small_3_0"
# ssh_allowed_cidrs          = ["0.0.0.0/0"]
# restrict_web_to_cloudflare = true
# ssh_allowed_ipv6_cidrs      = []
