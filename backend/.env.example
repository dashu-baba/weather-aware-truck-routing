# Copy to backend/.env - never commit .env
TOMTOM_API_KEY=your-tomtom-key

# Optional: DEBUG, INFO, WARNING, ERROR (default: DEBUG locally, INFO otherwise)
# LOG_LEVEL=INFO

# Number of trusted proxies in front of the app (default 0: use the socket address only).
# Set to 1 behind a single proxy such as Render, or the throttle sees every client as the proxy.
# NUM_PROXIES=1

# Comma-separated browser origins allowed by CORS (default: the Vite dev server).
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.example

# SQLite file for plan and weather-job records (default: backend/db.sqlite3). Run `python manage.py migrate`.
# DATABASE_PATH=/var/data/app.sqlite3

# Folder for plan JSON files (default: <system temp>/weather-aware).
# PLAN_DATA_DIR=/var/data/plans

# How long weather downloads and finished plans are kept, in seconds (defaults: 6 hours and 24 hours).
# WEATHER_JOB_TTL_S=21600
# PLAN_TTL_S=86400

# A running weather job with no progress for this many seconds is requeued (default 300).
# JOB_STALE_S=300

# Who runs the weather jobs: "thread" (default, the web process starts a worker on the first plan request)
# or "external" (run `python manage.py run_jobs` as a separate process). Use one worker process either way.
# JOB_WORKER=thread

# Hours of forecast each weather job fetches from the departure hour (default 72). Longer trips get a 422.
# JOB_WINDOW_HOURS=72
