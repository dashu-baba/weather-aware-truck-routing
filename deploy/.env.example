# Copy to deploy/.env for a local run (see "Running with Docker" in the README). On the server this file is
# written by the deploy workflow at /opt/truckroute/.env. Never commit the real file.

# Public host name. Use localhost for a local run.
APP_DOMAIN=truckroute.example.com
# Lowercase GitHub owner of the images on ghcr.io. Use "local" when building the images yourself.
IMAGE_OWNER=your-github-user-lowercase
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=generate-with-python-secrets-token_urlsafe-50
# Must include the public host, localhost and 127.0.0.1 (the health check) and backend (nginx's upstream name).
DJANGO_ALLOWED_HOSTS=truckroute.example.com,localhost,127.0.0.1,backend
# Empty: same origin, no cross-origin access.
CORS_ALLOWED_ORIGINS=
TOMTOM_API_KEY=
LOG_LEVEL=INFO
